{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keyway",
  "mainBinaryName": "keyway",
  "version": "0.2.9",
  "identifier": "com.conduit.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Keyway",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1000,
        "height": 680,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
